{% assign repo_parts = include.repository | split: '/' %}
{% assign details = site.data.repositories.repo_details[include.repository] %}
<article class="repository-card">
  {% if details.category %}
    <p class="repository-card-category">{{ details.category | escape }}</p>
  {% endif %}
  <h2 class="repository-card-title">
    <a href="https://github.com/{{ include.repository | escape }}">{{ details.title | default: repo_parts.last | escape }}</a>
  </h2>
  {% if details.description %}
    <p class="repository-card-description">{{ details.description | escape }}</p>
  {% endif %}
  <p class="repository-card-owner">{{ include.repository | escape }}</p>
</article>
